{
  "info": {
    "name": "weather-digest — Open-Meteo",
    "description": "Запросы геокодинга и прогноза погоды Open-Meteo, используемые утилитой weather-digest.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "geocodingUrl", "value": "https://geocoding-api.open-meteo.com/v1/search" },
    { "key": "forecastUrl", "value": "https://api.open-meteo.com/v1/forecast" },
    { "key": "city", "value": "Москва" },
    { "key": "lat", "value": "55.75204" },
    { "key": "lon", "value": "37.61781" },
    { "key": "days", "value": "3" }
  ],
  "item": [
    {
      "name": "Геокодинг",
      "item": [
        {
          "name": "Город найден",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{geocodingUrl}}?name={{city}}&count=1&language=ru&format=json",
              "host": ["{{geocodingUrl}}"],
              "query": [
                { "key": "name", "value": "{{city}}" },
                { "key": "count", "value": "1" },
                { "key": "language", "value": "ru" },
                { "key": "format", "value": "json" }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK — успешный ответ",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{geocodingUrl}}?name=Москва&count=1&language=ru&format=json",
                  "host": ["{{geocodingUrl}}"],
                  "query": [
                    { "key": "name", "value": "Москва" },
                    { "key": "count", "value": "1" },
                    { "key": "language", "value": "ru" },
                    { "key": "format", "value": "json" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"results\": [\n    {\n      \"id\": 524901,\n      \"name\": \"Москва\",\n      \"latitude\": 55.75204,\n      \"longitude\": 37.61781,\n      \"elevation\": 155,\n      \"feature_code\": \"PPLC\",\n      \"country_code\": \"RU\",\n      \"admin1_id\": 524894,\n      \"timezone\": \"Europe/Moscow\",\n      \"population\": 10381222,\n      \"country_id\": 2017370,\n      \"country\": \"Россия\",\n      \"admin1\": \"Москва\"\n    }\n  ],\n  \"generationtime_ms\": 1.2034178\n}"
            }
          ]
        },
        {
          "name": "Город не найден",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{geocodingUrl}}?name=Qwertyuiopasd&count=1&language=ru&format=json",
              "host": ["{{geocodingUrl}}"],
              "query": [
                { "key": "name", "value": "Qwertyuiopasd" },
                { "key": "count", "value": "1" },
                { "key": "language", "value": "ru" },
                { "key": "format", "value": "json" }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK — пустой результат (город не найден)",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{geocodingUrl}}?name=Qwertyuiopasd&count=1&language=ru&format=json",
                  "host": ["{{geocodingUrl}}"],
                  "query": [
                    { "key": "name", "value": "Qwertyuiopasd" },
                    { "key": "count", "value": "1" },
                    { "key": "language", "value": "ru" },
                    { "key": "format", "value": "json" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"generationtime_ms\": 0.11110306\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Прогноз погоды",
      "item": [
        {
          "name": "Прогноз по координатам",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{forecastUrl}}?latitude={{lat}}&longitude={{lon}}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days={{days}}&timezone=auto",
              "host": ["{{forecastUrl}}"],
              "query": [
                { "key": "latitude", "value": "{{lat}}" },
                { "key": "longitude", "value": "{{lon}}" },
                { "key": "daily", "value": "temperature_2m_max,temperature_2m_min,precipitation_sum" },
                { "key": "forecast_days", "value": "{{days}}" },
                { "key": "timezone", "value": "auto" }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK — успешный прогноз",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{forecastUrl}}?latitude=55.75204&longitude=37.61781&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days=3&timezone=auto",
                  "host": ["{{forecastUrl}}"],
                  "query": [
                    { "key": "latitude", "value": "55.75204" },
                    { "key": "longitude", "value": "37.61781" },
                    { "key": "daily", "value": "temperature_2m_max,temperature_2m_min,precipitation_sum" },
                    { "key": "forecast_days", "value": "3" },
                    { "key": "timezone", "value": "auto" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"latitude\": 55.75,\n  \"longitude\": 37.625,\n  \"generationtime_ms\": 0.045,\n  \"utc_offset_seconds\": 10800,\n  \"timezone\": \"Europe/Moscow\",\n  \"timezone_abbreviation\": \"GMT+3\",\n  \"elevation\": 151,\n  \"daily_units\": {\n    \"time\": \"iso8601\",\n    \"temperature_2m_max\": \"°C\",\n    \"temperature_2m_min\": \"°C\",\n    \"precipitation_sum\": \"mm\"\n  },\n  \"daily\": {\n    \"time\": [\"2026-09-13\", \"2026-09-14\", \"2026-09-15\"],\n    \"temperature_2m_max\": [16.2, 18.4, 18.6],\n    \"temperature_2m_min\": [7.7, 9.2, 11.7],\n    \"precipitation_sum\": [0, 0, 0.1]\n  }\n}"
            }
          ]
        },
        {
          "name": "Некорректные координаты (ошибка)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{forecastUrl}}?latitude=999&longitude=999&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days={{days}}&timezone=auto",
              "host": ["{{forecastUrl}}"],
              "query": [
                { "key": "latitude", "value": "999" },
                { "key": "longitude", "value": "999" },
                { "key": "daily", "value": "temperature_2m_max,temperature_2m_min,precipitation_sum" },
                { "key": "forecast_days", "value": "{{days}}" },
                { "key": "timezone", "value": "auto" }
              ]
            }
          },
          "response": [
            {
              "name": "400 Bad Request — некорректная широта",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{forecastUrl}}?latitude=999&longitude=999&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days=3&timezone=auto",
                  "host": ["{{forecastUrl}}"],
                  "query": [
                    { "key": "latitude", "value": "999" },
                    { "key": "longitude", "value": "999" },
                    { "key": "daily", "value": "temperature_2m_max,temperature_2m_min,precipitation_sum" },
                    { "key": "forecast_days", "value": "3" },
                    { "key": "timezone", "value": "auto" }
                  ]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": true,\n  \"reason\": \"Latitude must be in range of -90 to 90°. Given: 999.0.\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
